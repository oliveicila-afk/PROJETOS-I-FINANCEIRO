# ============================================
# SLACK NOTIFICATIONS (STAGING)
# ============================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/staging/test/webhook
SLACK_CHANNEL_ALERTS=#staging-alerts
SLACK_CHANNEL_LOGS=#staging-logs

# ============================================
# RETRY CONFIGURATION (STAGING)
# ============================================
RETRY_MAX_ATTEMPTS=3
RETRY_INITIAL_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000
RETRY_BACKOFF_MULTIPLIER=2

# ============================================
# POLLING CONFIGURATION (STAGING)
# ============================================
POLLING_ENABLED=true
POLLING_INTERVAL_MINUTES=15

# ============================================
# LOGGING AND SECURITY (STAGING)
# ============================================
LOG_SENSITIVE_DATA=true
MASK_CPF=false
LOG_LEVEL=debug

# ============================================
# HISTORY AND MONITORING (STAGING)
# ============================================
ARCHIVING_HISTORY_FILE=.archiving-history.staging.json
HISTORY_MAX_ENTRIES=100

# ============================================
# SERVER CONFIGURATION (STAGING)
# ============================================
PORT=3001
HOST=0.0.0.0

# ============================================
# ALERTING CONFIGURATION (STAGING)
# ============================================
ALERTING_ENABLED=true
ALERTING_SLACK_ENABLED=true
ALERTING_EMAIL_ENABLED=false
ALERTING_LOGGING_ENABLED=true
