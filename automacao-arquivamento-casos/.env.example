# ============================================
# ADVBOX API CONFIGURATION
# ============================================
ADVBOX_TOKEN=seu_token_advbox_aqui
ADVBOX_API_URL=https://app.advbox.com.br/api/v1

# ⚠️ CRITICAL: User IDs for task creation in archiving workflow
# Get these numeric IDs from Advbox user management/settings interface
# Required for automated task assignment:
# - ADVBOX_USER_ID_PRISCILA: User ID of Priscila (task creator)
# - ADVBOX_USER_ID_GABI: User ID of Gabi (responsible for archiving)
# - ADVBOX_USER_ID_ANDERSON: User ID of Anderson (legal responsible)
ADVBOX_USER_ID_PRISCILA=PENDING_NUMERIC_ID
ADVBOX_USER_ID_GABI=PENDING_NUMERIC_ID
ADVBOX_USER_ID_ANDERSON=PENDING_NUMERIC_ID

# Task Type ID for archiving tasks
# Confirmed task type: "ARQUIVAMENTO DEFINITIVO DE CLIENTE (1 pt)"
# Get this ID from Advbox API: GET /settings
ADVBOX_TASK_TYPE_ID_ARQUIVAMENTO=PENDING_NUMERIC_ID

# ============================================
# ASAAS API CONFIGURATION
# ============================================
# (para buscar número do processo nas descrições de cobrança)
ASAAS_API_TOKEN=seu_token_asaas_aqui
ASAAS_API_URL=https://api.asaas.com/v3

# Data de criação do token Asaas (formato: YYYY-MM-DD)
# IMPORTANTE: O token Asaas expira a cada 3 meses a partir da data de criação
# Inclua essa data para monitoramento automático de expiração
ASAAS_TOKEN_CREATED_DATE=2026-09-28

# ============================================
# LOGGING AND SECURITY
# ============================================
LOG_SENSITIVE_DATA=false
MASK_CPF=true
