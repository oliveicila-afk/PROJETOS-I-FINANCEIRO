# Advbox API
ADVBOX_TOKEN=seu_token_advbox_aqui
ADVBOX_API_URL=https://app.advbox.com.br/api/v1

# Asaas API (para buscar número do processo nas descrições de cobrança)
ASAAS_API_TOKEN=seu_token_asaas_aqui
ASAAS_API_URL=https://api.asaas.com/v3
# Data de criação do token Asaas (formato: YYYY-MM-DD)
# IMPORTANTE: O token Asaas expira a cada 3 meses a partir da data de criação
# Inclua essa data para monitoramento automático de expiração
ASAAS_TOKEN_CREATED_DATE=2026-09-28

# Segurança
LOG_SENSITIVE_DATA=false
MASK_CPF=true
